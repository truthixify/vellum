{
  "name": "@vellum/scoring",
  "version": "0.1.0",
  "private": true,
  "description": "Deterministic reputation scoring for Vellum Claim Cells.",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "bun run clean && tsc -p tsconfig.build.json",
    "clean": "rm -rf ./dist",
    "test": "bun test src",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@vellum/schemas": "workspace:*",
    "@usevellum/sdk": "workspace:*"
  },
  "devDependencies": {
    "bun-types": "1.4.2",
    "typescript": "5.8.3"
  }
}
