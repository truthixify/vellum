{
  "name": "@usevellum/sdk",
  "version": "0.0.0",
  "description": "Typed Claim Cell APIs for Vellum and CKB applications.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "CHANGELOG.md",
    "README.md"
  ],
  "sideEffects": false,
  "homepage": "https://github.com/truthixify/vellum#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/truthixify/vellum.git",
    "directory": "packages/sdk"
  },
  "bugs": {
    "url": "https://github.com/truthixify/vellum/issues"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "bun run clean && tsc -p tsconfig.build.json",
    "clean": "rm -rf ./dist",
    "example": "bun run examples/api.ts",
    "lint:package": "publint . && attw --profile esm-only --pack .",
    "prepack": "bun run build",
    "test": "bun test src",
    "test:testnet": "bun test testnet",
    "typecheck": "tsc --noEmit",
    "verify:package": "bun run build && tsc --noEmit -p tsconfig.examples.json && bun run example && bun pm pack --dry-run --ignore-scripts && bun run lint:package"
  },
  "dependencies": {
    "@ckb-ccc/core": "1.19.1",
    "@ckb-ccc/did-ckb": "0.2.9",
    "@ipld/dag-cbor": "10.0.2"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "bun-types": "1.4.2",
    "publint": "0.3.24",
    "typescript": "5.8.3"
  }
}
