{
  "name": "@vellum/schemas",
  "version": "0.0.0",
  "private": true,
  "description": "Canonical claim payload schemas for Vellum.",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "bun run clean && tsc -p tsconfig.build.json",
    "clean": "rm -rf ./dist",
    "prepack": "bun run build",
    "test": "bun test"
  },
  "dependencies": {
    "@ckb-ccc/core": "1.19.1"
  },
  "devDependencies": {
    "bun-types": "1.4.2"
  }
}
