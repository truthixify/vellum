{
  "encoding": "dag-cbor",
  "name": "klaveroq.milestone-settlement.v1",
  "payload": {
    "additionalProperties": false,
    "constraints": [
      "engagement_id, milestone_id, and delivery_id are domain-separated CKB hashes of private Klaveroq identifiers",
      "engagement_id and milestone_id identify one non-repeatable settled milestone",
      "settlement_tx_hash identifies a confirmed CKB settlement transaction"
    ],
    "properties": {
      "approval_method": {
        "enum": ["client", "review_timeout"],
        "type": "string"
      },
      "delivery_id": {
        "maxLength": 66,
        "minLength": 66,
        "pattern": "^0x[0-9a-f]{64}$",
        "type": "string"
      },
      "engagement_id": {
        "maxLength": 66,
        "minLength": 66,
        "pattern": "^0x[0-9a-f]{64}$",
        "type": "string"
      },
      "milestone_id": {
        "maxLength": 66,
        "minLength": 66,
        "pattern": "^0x[0-9a-f]{64}$",
        "type": "string"
      },
      "milestone_sequence": {
        "maximum": 4294967295,
        "minimum": 1,
        "type": "integer"
      },
      "settled_at": {
        "format": "unix-time-seconds",
        "maximum": 9007199254740991,
        "minimum": 1,
        "type": "integer"
      },
      "settlement_tx_hash": {
        "maxLength": 66,
        "minLength": 66,
        "pattern": "^0x[0-9a-f]{64}$",
        "type": "string"
      }
    },
    "required": [
      "engagement_id",
      "milestone_id",
      "delivery_id",
      "milestone_sequence",
      "approval_method",
      "settled_at",
      "settlement_tx_hash"
    ],
    "type": "object"
  },
  "version": 1
}
